{
  "name": "eleventy-netlify-boilerplate",
  "version": "1.0.4",
  "description": "A boilerplate for building a fast static website with the Eleventy static site generator, for deployment to Netlify.",
  "main": "dist/index.js",
  "scripts": {
    "build": "eleventy",
    "watch": "eleventy --watch",
    "serve": "eleventy --serve",
    "start": "concurrently \"eleventy --serve --quiet\" \"decap-server\"",
    "gemini:server:prebuild": "npm run typecheck",
    "gemini:server:build": "tsc",
    "gemini:server:prestart": "npm run gemini:build && npm run gemini:server:build",
    "gemini:server:start": "node .",
    "gemini:server:all": "npm run gemini:server:start",
    "gemini:build": "eleventy --quiet --config=.eleventy.config.gemini.js",
    "gemini": "npm run gemini:server:build && concurrently \"eleventy --watch --quiet --config=.eleventy.config.gemini.js\" \"node .\"",
    "gemini:server:debug": "npm run gemini",
    "gemini:debug": "DEBUG=* eleventy --watch --quiet --config=.eleventy.config.gemini.js",
    "debug": "DEBUG=* eleventy --serve --quiet",
    "test": "npm run test:clean && npm run build && npm run gemini:build && npm run test:compile && node --test tests/*.test.cjs && npm run test:a11y",
    "test:compile": "tsc -p tsconfig.test.json",
    "test:frontend": "npm run build && npm run gemini:build && node --test tests/frontend.test.cjs",
    "test:admin": "npm run build && npm run test:compile && node --test tests/admin.test.cjs tests/api.test.cjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p api && tsc -p workers",
    "test:clean": "node -e \"for(const p of ['_site','_gemini','.test-dist']) require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "test:a11y": "node scripts/test-a11y.cjs",
    "resume:setup": "node scripts/resume.cjs setup",
    "resume": "node scripts/resume.cjs render",
    "resume:watch": "node scripts/resume.cjs render --watch",
    "diagrams:setup": "node scripts/diagrams.cjs setup",
    "diagrams:extract": "node scripts/diagrams.cjs extract",
    "diagrams:export": "node scripts/diagrams.cjs export",
    "diagrams:check": "node scripts/diagrams.cjs check",
    "workers:build": "export RESUME_VENV=node_modules/.cache/resume-venv && npm run resume:setup && npm run resume -- --dont-generate-png && npm run build && node scripts/workers-assets.cjs",
    "workers:deploy": "npm run workers:build && npx wrangler deploy",
    "workers:types": "npx wrangler types workers/worker-configuration.d.ts",
    "test:workers": "node scripts/test-workers.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danurbanowicz/eleventy-netlify-boilerplate"
  },
  "author": {
    "name": "Dan Urbanowicz",
    "email": "dan.urbanowicz@gmail.com",
    "url": "https://github.com/danurbanowicz"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/danurbanowicz/eleventy-netlify-boilerplate/issues"
  },
  "homepage": "https://github.com/danurbanowicz/eleventy-netlify-boilerplate",
  "devDependencies": {
    "@11ty/eleventy": "3.1.7",
    "@11ty/eleventy-img": "7.1.0",
    "@11ty/eleventy-navigation": "1.0.5",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "clean-css": "5.3.3",
    "concurrently": "10.0.6",
    "date-fns": "4.4.0",
    "decap-server": "3.11.5",
    "htm": "3.1.1",
    "html-minifier-terser": "7.2.0",
    "js-yaml": "5.5.0",
    "linkedom": "0.18.13",
    "luxon": "3.7.2",
    "markdown-it": "15.0.3",
    "markdown-it-anchor": "10.0.0",
    "netlify-plugin-a11y": "0.0.12",
    "typescript": "7.0.2",
    "uglify-js": "3.19.3",
    "wrangler": "4.155.0"
  },
  "dependencies": {
    "@netlify/functions": "6.0.3",
    "express": "5.3.0",
    "gemdown": "0.8.0",
    "gemini-server": "2.1.1",
    "serverless-http": "4.0.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "netlify-plugin-a11y": {
      "pa11y": "10.0.0"
    }
  },
  "allowScripts": {
    "puppeteer@25.15.0": true
  }
}
