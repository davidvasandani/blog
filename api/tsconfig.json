{
  // Vercel Functions. Vercel compiles them from a temporary config that
  // extends this one, so type roots are anchored to this directory.
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "typeRoots": ["../node_modules/@types"],
    "types": ["node"]
  },
  "include": ["**/*.ts"]
}
