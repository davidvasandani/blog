{
  // Shared Express application used by the Worker.
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "typeRoots": ["../node_modules/@types"],
    "types": ["node"]
  },
  "include": ["**/*.ts"]
}
